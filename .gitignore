# ===========================================
# VisionX - Production .gitignore
# AI-Powered Digital Trust Platform
# ===========================================

# ===========================================
# SECRETS & ENVIRONMENT FILES
# NEVER commit these - contain API keys, JWT secrets, DB credentials
# ===========================================
.env
.env.local
.env.*
.env.*.local
*.env
backend/.env
frontend/.env.local
frontend/.env.*
*.pem
*.key
*.cert
credentials.json
service-account.json
firebase-*.json

# ===========================================
# PYTHON - Cache, Build, Virtual Env
# ===========================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
virtualenv/
*.egg-info/
dist/
*.egg
build/
*.whl
.python-version
pip-log.txt
pip-delete-this-directory.txt

# ===========================================
# NODE.JS - Dependencies & Build Output
# ===========================================
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp
.pnp.js
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.eslintcache
.pnpm-debug.log*

# ===========================================
# TESTING ARTIFACTS - Generated during test runs
# Keep test source files, ignore generated output
# ===========================================
test-results/
playwright-report/
playwright/.auth/
coverage/
htmlcov/
.allure/
allure-results/
allure-report/
screenshots/
videos/
artifacts/
snapshots/
*.log
junit.xml
test-results.json
final_verification.json
audit_results.json
test_results.json
test-*.jpg
test-*.png
final-test.jpg
test-image.jpg
test-audit.jpg

# ===========================================
# GENERATED REPORTS & EXPORTS
# ===========================================
generated_reports/
report_output/
exports/
pdf_output/
*.pdf
*.csv
*.xlsx

# ===========================================
# UPLOADED TEST DATA - Runtime generated, not source
# ===========================================
test_uploads/
mock_uploads/
temp/
tmp/
uploads/
temp_uploads/

# ===========================================
# IDE & EDITOR FILES
# ===========================================
.idea/
.vscode/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-workspace

# ===========================================
# OS GENERATED FILES
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===========================================
# DEPLOYMENT CONFIG - Keep template, ignore local overrides
# ===========================================
vercel.json
railway.json
Dockerfile
docker-compose.yml
.vercel

# ===========================================
# LOG FILES
# ===========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

/backend/requirements.txt

# ===========================================
# SOURCE CODE TO ALWAYS TRACK
# (These are explicitly allowed through negation)
# ===========================================
!tests/
!tests/**/*.py
!tests/**/*.ts
!tests/playwright/
!tests/e2e/
!.gitignore

# Production stack (no secrets; values come from env files on the server)
!deploy/docker-compose.yml
